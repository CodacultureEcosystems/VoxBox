[Desktop Entry]
Type=Application
Name=VoxBox
GenericName=Voice Dictation & Voice Shell
Comment=Click to talk — speech is typed into the focused app
Exec=vbd --toggle
TryExec=vbd
Icon=voxbox
Terminal=false
Categories=Utility;Accessibility;AudioVideo;
Keywords=voice;dictation;speech;whisper;parakeet;stt;tts;microphone;studio;
StartupNotify=false
X-GNOME-UsesNotifications=true
Actions=studio;dictation;shell;textshell;

[Desktop Action studio]
Name=Open VoxBox Studio (voice, engines, agents)
Exec=vbd --window

[Desktop Action dictation]
Name=Dictation (vbd resident: hotkey -> speech -> typed text)
Exec=vbd

[Desktop Action shell]
Name=Voice shell (speak commands, spoken replies)
Exec=voxbox

[Desktop Action textshell]
Name=Voice shell, text mode (no microphone)
Exec=voxbox --text
